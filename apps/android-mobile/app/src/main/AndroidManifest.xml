<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Android 17 (API 37) blocca per impostazione predefinita l'accesso alla rete
      locale per le app che dichiarano targetSdk 37. I server Xtream sono spesso
      raggiunti tramite indirizzo privato della rete di casa: senza questo
      permesso runtime, dichiarato qui e richiesto dall'app prima del primo
      accesso, le connessioni al server locale vengono scartate dal sistema.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
      App per tablet con interfaccia touch: nessuna feature leanback, nessun
      banner e launcher con la sola categoria LAUNCHER. Nessuna autorizzazione
      per l'installazione di pacchetti e nessun attributo picture-in-picture
      in questo PR (l'aggiornamento in-app arriva nel PR4).
    -->
    <application
        android:name=".FvpApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.FelixVP">

        <receiver android:name=".ui.player.PlayerPipAction" android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenLayout|screenSize|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
