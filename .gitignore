node_modules/
build/
dist/
coverage/
.wrangler/
.DS_Store
*.log
.env*
!.env.example
# La configurazione della build webOS non contiene segreti: deve essere
# versionata perché la build del TV sia riproducibile.
!.env.webos

# Elenco locale dei provider abilitati al proxy (generato a runtime)
data/allowed-hosts.json

# Materiale di riferimento APK (estrazione apktool/JADX): non è codice del prodotto
# ed è conservato fuori dal repository dal proprietario; resta recuperabile dalla
# storia git (vedi reference/README.md).
Progetto-APK/

# App Android TV (apps/android-tv): artefatti di build locali
apps/android-tv/.gradle/
apps/android-tv/build/
apps/android-tv/app/build/
apps/android-tv/local.properties
apps/android-tv/.idea/
apps/android-tv/**/*.apk
apps/android-tv/.kotlin/

# App LG webOS (apps/webos-tv): build, pacchetto e dipendenze generate localmente
apps/webos-tv/build/
apps/webos-tv/dist/
apps/webos-tv/node_modules/
apps/webos-tv/.local/
apps/webos-tv/**/*.local.*
*.ipk
