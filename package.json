{
  "name": "felixvision-player",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:safe": "XTREAM_SAFE_MODE=1 tsx server.ts",
    "build": "vite build",
    "build:webos": "vite build --mode webos",
    "package:webos": "node tools/webos/package.mjs",
    "install:webos-tv": "npm --prefix apps/webos-tv run install-tv",
    "launch:webos-tv": "npm --prefix apps/webos-tv run launch",
    "test:webos:tv": "node tools/webos/tv-smoke.mjs",
    "build:static": "vite build --mode static",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build",
    "mock:xtream": "tsx tools/xtream-mock/server.ts",
    "mock:xtream:small": "XTREAM_MOCK_PROFILE=small tsx tools/xtream-mock/server.ts",
    "mock:xtream:visual": "XTREAM_MOCK_PROFILE=visual tsx tools/xtream-mock/server.ts",
    "mock:xtream:public": "XTREAM_MOCK_PROFILE=visual XTREAM_MOCK_PUBLIC_PLAYLIST=1 tsx tools/xtream-mock/server.ts",
    "mock:xtream:stress": "XTREAM_MOCK_PROFILE=stress tsx tools/xtream-mock/server.ts",
    "cap:build": "npm run build && cap sync",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@tanstack/react-virtual": "^3.14.13",
    "express": "^4.21.2",
    "hls.js": "^1.7.3",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^0.546.0",
    "mpegts.js": "^1.8.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "playwright": "1.64.1",
    "react-test-renderer": "^19.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
