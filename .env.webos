# Build dedicata a LG webOS (vite build --mode webos).
# VITE_TARGET=webos attiva la modalità TV diretta, senza proxy Express.
VITE_TARGET=webos
# Relay di abbinamento TV/telefono: è raggiungibile dal telefono, a differenza
# del file:// interno al pacchetto .ipk.
VITE_PAIRING_RELAY_URL=https://felixvision-pairing-relay.manganiellofelice.workers.dev
