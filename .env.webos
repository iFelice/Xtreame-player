# Build dedicata a LG webOS (vite build --mode webos).
# VITE_TARGET=webos attiva la modalità diretta: niente proxy Express, motore
# video nativo, nessuna funzione di download.
VITE_TARGET=webos
# Relay di abbinamento TV/telefono: su webOS è l'unica origine pair disponibile
# (il server Express locale con /api/session/* non esiste nel pacchetto .ipk).
VITE_PAIRING_RELAY_URL=https://felixvision-pairing-relay.manganiellofelice.workers.dev
